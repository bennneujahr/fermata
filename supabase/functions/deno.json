{
  "imports": {
    "postgres": "npm:postgres@3.4.7",
    "zod": "npm:zod@4.6.5",
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding": "jsr:@std/encoding@1"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "deno.window", "dom"]
  },
  "lint": {
    "rules": { "exclude": ["no-explicit-any"] }
  },
  "fmt": {
    "lineWidth": 120
  },
  "tasks": {
    "test": "deno test --allow-env --allow-net --allow-read",
    "check": "deno check **/*.ts"
  }
}
