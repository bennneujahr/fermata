---
import Fermate from "../components/Fermate.astro";
import { bestaetigen as t } from "../content/pages";
import Base from "../layouts/Base.astro";
---
<Base title={t.title} noindex>
  <section class="page">
    <div class="wrap page-center">
      <Fermate class="page-mark" />
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="page-title">{t.heading}</h1>
      <p class="page-lead">{t.lead}</p>
      <div class="tips">
        <h2>{t.tipsTitle}</h2>
        <ul>
          {t.tips.map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
      <div class="page-actions">
        <a class="text-link" href={t.back.href}>{t.back.label}</a>
      </div>
    </div>
  </section>
</Base>
