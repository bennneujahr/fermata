---
import { privacy } from "../content/home";
import Fermate from "./Fermate.astro";
---
<section class="section" id={privacy.id} aria-labelledby="daten-title">
  <div class="wrap">
    <header class="section-head">
      <div>
        <p class="eyebrow">{privacy.eyebrow}</p>
        <h2 class="section-title" id="daten-title">{privacy.title}</h2>
      </div>
      <p class="section-intro">{privacy.intro}</p>
    </header>
    <ul class="privacy-grid">
      {privacy.items.map((item) => (
        <li>
          <h3><Fermate />{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
    <p class="privacy-link"><a class="text-link" href={privacy.link.href}>{privacy.link.label} <span aria-hidden="true">→</span></a></p>
  </div>
</section>
