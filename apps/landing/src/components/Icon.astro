---
// Schlichte Linien-Symbole (24 × 24, Strich 1,5), rein dekorativ.
interface Props {
  name: "ausweis" | "melden" | "hilfe" | "ort" | "check" | "telefon";
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "ausweis" && (
    <>
      <rect x="2.75" y="5" width="18.5" height="14" rx="2.25"></rect>
      <circle cx="8.5" cy="10.75" r="2"></circle>
      <path d="M5.5 16c.7-1.5 1.8-2.25 3-2.25s2.3.75 3 2.25M14.5 10h3.75M14.5 13.25h3.75"></path>
    </>
  )}
  {name === "melden" && <path d="M5.5 21V3.75M5.5 4.25h11.75l-2.5 4.25 2.5 4.25H5.5"></path>}
  {name === "hilfe" && (
    <>
      <circle cx="12" cy="12" r="8.75"></circle>
      <circle cx="12" cy="12" r="3.75"></circle>
      <path d="M5.8 5.8l3.55 3.55M14.65 14.65l3.55 3.55M18.2 5.8l-3.55 3.55M9.35 14.65L5.8 18.2"></path>
    </>
  )}
  {name === "ort" && (
    <>
      <path d="M12 21.25s-6.75-5.6-6.75-11.25a6.75 6.75 0 0 1 13.5 0c0 5.65-6.75 11.25-6.75 11.25Z"></path>
      <circle cx="12" cy="10" r="2.4"></circle>
    </>
  )}
  {name === "check" && <path d="M4.75 12.75l4.5 4.5L19.25 7"></path>}
  {name === "telefon" && (
    <path d="M5.25 3.75h3.1l1.6 4.1-2.05 1.35a11.5 11.5 0 0 0 6.9 6.9l1.35-2.05 4.1 1.6v3.1a2 2 0 0 1-2.15 2A16.5 16.5 0 0 1 3.25 5.9a2 2 0 0 1 2-2.15Z"></path>
  )}
</svg>
