{
  "name": "@fermata/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fermata Web-App / PWA für Mitglieder und Admin (Next.js, App Router).",
  "scripts": {
    "prepare-assets": "node scripts/copy-brand.mjs",
    "dev": "node scripts/copy-brand.mjs && next dev --port 3041",
    "build": "node scripts/copy-brand.mjs && next build",
    "start": "next start --port 3041",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "stack": "bash scripts/stack.sh"
  },
  "dependencies": {
    "@fermata/brand": "workspace:*",
    "@fermata/tokens": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postgres": "3.4.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
