# Web-App (apps/web). Werte für die gehostete Umgebung in Vercel eintragen (Region fra1).
# Lokal schreibt `pnpm --filter @fermata/web stack up` alles nach .stack/env.

# Supabase (Frankfurt). Der öffentliche Schlüssel darf in den Browser (RLS schützt die Daten).
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon- bzw. publishable key>
# Optional: andere Adresse der Edge Functions (Standard: <SUPABASE_URL>/functions/v1)
# SUPABASE_FUNCTIONS_URL=

# Umgebung: production | staging | local | test | ci
FERMATA_ENV=production

# Ausweisprüfung: live (Didit) oder fake (nur lokal/Tests, Simulationsseite)
DIDIT_MODE=live
# Nur bei DIDIT_MODE=fake nötig (Simulationsseite signiert den Webhook wie Didit):
# DIDIT_WEBHOOK_SECRET=

# Später (M5/M6/M3): zusätzliche erlaubte Ziele in der CSP, durch Leerzeichen getrennt
# FERMATA_CSP_EXTRA_CONNECT=https://api.stripe.com wss://<livekit>
# FERMATA_CSP_EXTRA_FRAME=https://js.stripe.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Service Worker auch in `next dev` anmelden (sonst nur im Produktions-Build)
# NEXT_PUBLIC_SW_DEV=1
