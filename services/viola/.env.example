# Viola – Umgebungsvariablen (Beispiel ohne Geheimnisse). Kopie als .env, nie einchecken.
# Fachliche Werte (Modell, Zeitlimits, Preise, Stimme) kommen aus ops.app_settings über interview-agent.
# Ohne Zugänge läuft alles mit Attrappen: VIOLA_LLM_PROVIDER=fake, VIOLA_BACKEND=memory.

# --- Umgebung -----------------------------------------------------------------
VIOLA_ENV=local                      # local | test | staging | production (production erzwingt EU-Wege und echte Anbieter)
VIOLA_LOG_LEVEL=INFO

# --- Rückweg in die Datenbank (nur über die Edge Function interview-agent) -------
VIOLA_BACKEND=memory                 # http | memory (Attrappe)
INTERVIEW_AGENT_URL=https://PROJEKT.supabase.co/functions/v1/interview-agent
INTERVIEW_AGENT_SECRET=              # mindestens 32 Zeichen, gleicher Wert wie in den Supabase-Secrets

# --- Sprachmodell: Claude Sonnet 5.5 über Amazon Bedrock (EU) -------------------
VIOLA_LLM_PROVIDER=fake              # bedrock | anthropic (nur Entwicklung) | fake
VIOLA_AWS_REGION=eu-central-1        # Bedrock-Client (Mantle), nur EU-Regionen erlaubt
# AWS-Zugang über die Task-Rolle (ECS) oder AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN
VIOLA_LLM_MODEL_ID=                  # leer = voice.llm_model_id (eu.anthropic.claude-sonnet-5-5)
VIOLA_ANALYSIS_MODEL_ID=             # leer = analysis.llm_model_id
VIOLA_LLM_MAX_TOKENS=2048
VIOLA_ANALYSIS_MAX_TOKENS=16000
VIOLA_SYSTEM_NOTICES=system_message  # system_message (Sonnet 5.5) | user_text (Ausweichweg)
VIOLA_EAGER_TOOL_STREAMING=false     # true nur, wenn Bedrock das Feld annimmt (dann prüft die API Werkzeug-Eingaben nicht mehr)
# ANTHROPIC_API_KEY=                 # nur bei VIOLA_LLM_PROVIDER=anthropic (Entwicklung, kein EU-Weg)

# --- Spracherkennung: Deepgram Nova-3, Deutsch, EU-Endpunkt ----------------------
DEEPGRAM_API_KEY=
DEEPGRAM_URL=https://api.eu.deepgram.com/v1/listen
VIOLA_STT_GATE=true                  # Stille nicht an Deepgram senden (Silero-VAD vor der Erkennung)

# --- Stimme (TTS) -----------------------------------------------------------------
VIOLA_TTS_PROVIDER=                  # leer = voice.tts_provider (polly); polly | google | cartesia | elevenlabs | fake
VIOLA_TTS_VOICE=                     # leer = voice.tts_voice (Vicki)
VIOLA_TTS_ENTERPRISE_EU=false        # true nur mit Enterprise-Vertrag samt EU-Datenhaltung (Cartesia, ElevenLabs)
GOOGLE_TTS_ENDPOINT=eu-texttospeech.googleapis.com
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google.json   # nur mit Extra „google“
CARTESIA_API_KEY=
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io   # EU-Datenhaltung (Enterprise): https://api.eu.residency.elevenlabs.io
ELEVENLABS_VOICE_ID=

# --- LiveKit (Weg A, B oder C – gleicher Code) -----------------------------------
LIVEKIT_URL=wss://livekit.fermata.example   # Weg C: eigener Server in Frankfurt; Weg A/B: wss://PROJEKT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=viola             # muss zu LIVEKIT_AGENT_NAME der Edge Function interview-token passen
VIOLA_LIVEKIT_PATH=                  # leer = voice.livekit_path (nur Kostenschätzung)

# --- Textmodus („Text statt Stimme“) ------------------------------------------------
VIOLA_TEXT_TOKEN_SECRET=             # mindestens 32 Zeichen, gleicher Wert wie in den Supabase-Secrets (interview-token)
VIOLA_TEXT_ALLOWED_ORIGINS=http://localhost:3000
VIOLA_TEXT_HOST=0.0.0.0
VIOLA_TEXT_PORT=8352
